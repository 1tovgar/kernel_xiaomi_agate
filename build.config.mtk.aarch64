ARCH=arm64
CROSS_COMPILE=aarch64-none-linux-gnu-
LLVM=1
LLVM_IAS=1
LD_LIBRARY_PATH=clang-r383902/lib64:$$LD_LIBRARY_PATH
DEFCONFIG=agate_defconfig
KERNEL_DIR=kernel
CLANG_PREBUILT_BIN=clang-r383902/bin
# for check scripts
CC=clang
LD=ld.lld
AR=llvm-ar
NM=llvm-nm
OBJCOPY=llvm-objcopy
OBJDUMP=llvm-objdump
READELF=llvm-readelf
OBJSIZE=llvm-size
STRIP=llvm-strip
